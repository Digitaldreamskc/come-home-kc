# Isolated development database. These two browser-safe values are required.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-ISOLATED-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_development_publishable_key

# Optional browser-test target. Leave unset for the local production server.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100

# CLI imports can use a server-only service key supplied separately in the shell.
# Do not deploy an import service key to the browser or commit it to this file.
# SUPABASE_SERVICE_ROLE_KEY=
# CONFIRM_ISOLATED_DATABASE=yes


NEXT_PUBLIC_TENANT_KEY=back2kc
# Localhost-only synthetic layout preview; omit in hosted environments.
ENABLE_LOCAL_DEMO=1

# Optional transactional status notifications. Keep disabled until authorization
# and a controlled end-to-end send have been verified. Never use NEXT_PUBLIC_.
GMAIL_DELIVERY_ENABLED=false
GMAIL_SENDER=mary@socialbalances.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Independent civic settings, supplied securely in .env.local. Current preview
# deliberately permits only the authorized isolated development project.
CIVIC_SUPABASE_URL=https://YOUR-ISOLATED-PROJECT.supabase.co
CIVIC_SUPABASE_PUBLISHABLE_KEY=replace_with_development_publishable_key
# Defaults to Back2KC. Civic and showcase modes also require their enable flag.
APP_MODE=back2kc
ENABLE_CIVIC_DEMO=0
ENABLE_PLATFORM_SHOWCASE=0
